APP_NAME=Aeterna
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aeterna
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@aeterna.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jooble job board
JOOBLE_ENABLED=true
JOOBLE_HOST=jooble.org
JOOBLE_API_KEY=
JOOBLE_DAILY_BUDGET=25
JOOBLE_CACHE_TTL=86400

# emploi.ma job board via Parse.bot.
# Every endpoint costs 1 credit; the free tier is 200/month at 5 req/min.
PARSEBOT_API_KEY=
PARSEBOT_MONTHLY_BUDGET=180
PARSEBOT_CACHE_TTL=86400

EMPLOIMA_ENABLED=true
EMPLOIMA_BASE_URL=https://api.parse.bot/

LINKEDIN_ENABLED=true
LINKEDIN_BASE_URL=https://api.parse.bot/scraper/
LINKEDIN_DEFAULT_LOCATION=Morocco

# The Aeterna Assistant . A local model: ,
# no key, nothing leaves this machine. Pull one first, e.g.
#   ollama pull llama3.2:3b     (~2 GB, fits 4 GB VRAM, fast)
#   ollama pull qwen2.5:7b      (~4.7 GB, slower here, better at tools)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
AI_MAX_TOOL_ITERATIONS=3
AI_JOB_SEARCHES_PER_CONVERSATION=5
AI_HISTORY_LIMIT=20

DEMO_REQUEST_RECIPIENT=
